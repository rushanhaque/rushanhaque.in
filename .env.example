# Formspree form id for the contact and quote forms (optional; overrides the one in src/config/site.js)
VITE_FORMSPREE_ID=

# Site verification, written into every page at build time (optional; DNS verification also works)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# The /admin page, set on Vercel (not needed for local work)
# The password for /admin
ADMIN_PUBLISH_SECRET=
# Signs the admin session cookie: any long random string
CMS_SESSION_SECRET=
# A GitHub token that can commit to this repository, so /admin can publish the About text and clients
GITHUB_TOKEN=
