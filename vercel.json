      "destination": "/work/mailwright",
      "permanent": true
    },
    {
      "source": "/projects/:slug",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/connect",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/schedule",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/#reviews",
      "permanent": true
    },
    {
      "source": "/review",
      "destination": "/#reviews",
      "permanent": true
    },
    {
      "source": "/review.html",
      "destination": "/#reviews",
      "permanent": true
    },
    {
      "source": "/write-a-review",
      "destination": "/#reviews",
      "permanent": true
    },
    {
