    },
    {
      "source": "/studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/playground",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed.xml",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights/:slug",
      "destination": "/",
