{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rushanhaque.in"
        }
      ],
      "destination": "https://www.rushanhaque.in/:path*",
      "permanent": true
    },
    {
      "source": "/projects/taif",
      "destination": "/work/taif",
      "permanent": true
    },
    {
      "source": "/projects/erfolg-living",
