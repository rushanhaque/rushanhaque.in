{
  "outputDirectory": ".",
  "buildCommand": "node scripts/build-pages.mjs && node scripts/prerender.mjs && node scripts/seo-schema.mjs && node scripts/sitemap.mjs && node scripts/validate-config.mjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/works-default",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/works-default.html",
      "destination": "/work",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/version.json",
      "destination": "/api/version"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/img/rh/(products|projects|reviews)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
